{
  "$schema": "../gen/schemas/mobile-schema.json",
  "identifier": "mobile",
  "description": "Capability for the main window on phones",
  "platforms": ["android", "iOS"],
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    "core:app:allow-register-listener",
    "core:app:allow-remove-listener",
    "core:app:allow-exit"
  ]
}
